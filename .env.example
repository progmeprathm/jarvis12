# Deepgram API Key (for speech-to-text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key (for GPT responses)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key (for text-to-speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ElevenLabs Voice ID (default: Adam)
ELEVENLABS_VOICE_ID=Adam

# Optional: OpenAI Model (default: gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# JARVIS System Prompt
JARVIS_SYSTEM_PROMPT=You are Jarvis, a witty and helpful AI assistant. Keep your answers to 1-2 short sentences.
